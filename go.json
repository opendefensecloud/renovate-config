{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "matchDatasources": ["docker", "golang-version"],
      "matchPackageNames": ["go", "golang"],
      "groupName": "golang version sync",
      "groupSlug": "go-version"
    },
    {
      "description": "No stability window for the golang image: Docker Hub's timestamp is the last re-push, reset by every base-image rebuild, so the window holds the Dockerfile back while go.mod and flake.nix move. The golang-version release age gates the group",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "goVersion\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    }
  ]
}
