{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Group k8s.io/*, controller-runtime, controller-tools, Helm v4, and OCM together — they share k8s library dependencies and must use the exact same version; bumping any one without the others breaks the build",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "helm.sh/helm/v4",
        "ocm.software/ocm"
      ],
      "groupName": "kubernetes dependencies",
      "groupSlug": "k8s-deps"
    },
    {
      "description": "Include envtest Kubernetes version (ENVTEST_K8S_VERSION in Makefile) in the same group",
      "matchPackageNames": ["kubernetes/kubernetes"],
      "groupName": "kubernetes dependencies",
      "groupSlug": "k8s-deps"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["Makefile"],
      "matchStrings": [
        "ENVTEST_K8S_VERSION \\?= (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
