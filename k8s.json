{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Add ok-to-helm label to patch, digest, and minor PRs in k8s repos so chart-publish CI runs; unrelated to automerge",
      "matchUpdateTypes": ["patch", "digest", "minor"],
      "addLabels": ["ok-to-helm"]
    },
    {
      "description": "Group k8s.io/*, controller-runtime, controller-tools, Helm v4, and OCM together — they share k8s library dependencies and must use the exact same version; bumping any one without the others breaks the build",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-tools",
        "helm.sh/helm/v4",
        "ocm.software/ocm"
      ],
      "groupName": "kubernetes dependencies",
      "groupSlug": "k8s-updates",
      "addLabels": ["ok-to-image", "ok-to-helm"]
    },
    {
      "description": "Include envtest Kubernetes version (ENVTEST_K8S_VERSION in Makefile) in the same group; version is capped by kindest/node availability",
      "matchPackageNames": ["kindest/node"],
      "groupName": "kubernetes dependencies",
      "groupSlug": "k8s-updates"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "ENVTEST_K8S_VERSION \\?= (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "kindest/node",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
