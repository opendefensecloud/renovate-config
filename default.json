{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "pinDigests": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": [],
    "minimumReleaseAge": null,
    "automerge": false,
    "addLabels": ["security"]
  },
  "nix": {
    "enabled": true,
    "pinDigests": false,
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["before 5am on Monday"]
    }
  },
  "packageRules": [
    {
      "description": "Auto-merge patch and digest updates: patch updates wait a 3-day stability window",
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "dependencies (patch & digest)",
      "groupSlug": "all-patch-and-digest-updates",
      "minimumReleaseAge": "3 days",
      "schedule": ["before 5am on Monday"],
      "automerge": true,
      "addLabels": ["ok-to-image"]
    },
    {
      "description": "The automerge label (what the auto-approve workflow reacts to) goes on patch and digest updates, except dev-kit's: labels can't be removed by a later rule",
      "matchUpdateTypes": ["patch", "digest"],
      "matchPackageNames": ["!opendefensecloud/dev-kit"],
      "addLabels": ["automerge"]
    },
    {
      "description": "Skip minimum release age requirement for digest updates since they often lack a release timestamp",
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Minor updates: grouped weekly after a 3-day stability window, reviewed by a human",
      "matchUpdateTypes": ["minor"],
      "groupName": "dependencies (minor)",
      "groupSlug": "all-minor-updates",
      "minimumReleaseAge": "3 days",
      "schedule": ["before 5am on Monday"],
      "addLabels": ["ok-to-image"]
    },
    {
      "description": "Set minimum release age requirement for major updates to 10 days",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "10 days",
      "addLabels": ["ok-to-image"]
    },
    {
      "description": "Group every opendefensecloud/dev-kit pin (Makefile, flake.nix, GitHub Actions) into one PR. Never automerged: Renovate can't update flake.lock for the flake input, so the PR needs one commit from a human",
      "matchPackageNames": ["opendefensecloud/dev-kit"],
      "groupName": "dev-kit",
      "automerge": false
    },
    {
      "description": "Only dev-kit PRs that change the flake input need the flake.lock commit",
      "matchPackageNames": ["opendefensecloud/dev-kit"],
      "matchFileNames": ["**/flake.nix"],
      "prBodyNotes": [
        "This PR bumps the dev-kit flake input but not `flake.lock`. Run `nix flake update dev-kit` on this branch and push the result. Until then, CI jobs that check for a clean working tree fail, because `nix develop` rewrites the lock."
      ]
    },
    {
      "description": "Disable digest pinning for tools inside GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["helm"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Makefile$/", "/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "DEV_KIT_VERSION := (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)",
        "github:opendefensecloud/dev-kit/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "opendefensecloud/dev-kit",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["tools.lock"],
      "matchStrings": [
        "(?<depName>[^\\s]+) (?<packageName>[^@]+)@(?<currentValue>v?[^\\s]+)"
      ],
      "versioningTemplate": "semver",
      "datasourceTemplate": "go"
    }
  ]
}
